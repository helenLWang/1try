<div id="message_recap_overlay" class="overlay" data-overlay="recap" tabindex="-1">
    <div class="flex overlay-content">
        <div class="overlay-messages-container overlay-container recap-container">
            <div class="overlay-messages-header">
                <h1>{{t "Unread recap" }}</h1>
                <div class="exit">
                    <span class="exit-sign">&times;</span>
                </div>
            </div>
            <div class="recap-body overlay-messages-list">
                <div class="recap-status">{{t "Generating recap…" }}</div>
            </div>
        </div>
    </div>
</div>
