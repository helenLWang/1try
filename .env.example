# Copy this file to `.env` or export the variables in your shell.
# Do not commit real keys. The tool never writes secrets into the repo.

# --- Option A: OpenAI or any OpenAI-compatible endpoint (OpenRouter, Groq, Azure, vLLM) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_BASE_URL=https://api.openai.com/v1
# Azure example:
# OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# OPENAI_API_KEY=YOUR_AZURE_KEY

# --- Option B: OpenRouter ---
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-or-REPLACE_ME
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Option C: Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Option D: Google Gemini ---
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=REPLACE_ME
