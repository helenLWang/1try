# Put your OpenAI or Gemini API key on the first line of a file named api.key
# in the repository root (that file is gitignored).
#
#   cp api.key.example api.key
#   # then paste the key
#
# OpenAI:
#   export OPENAI_API_KEY=sk-...
#   export LLM_MODEL=gpt-4o-mini
# Gemini (I1 allows this). New AI Studio keys start with AQ. :
#   export GEMINI_API_KEY=AQ....
#   # or paste the key into api.key — AQ. / AIza prefixes are auto-detected
sk-or-AQ-your-key-here
